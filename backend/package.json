{
  "name": "english-course-backend",
  "version": "1.0.0",
  "description": "Backend API for English Course Online",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test:phase1": "node --test tests/phase1Security.test.js",
    "test:phase2": "node --test tests/phase2ExamEngine.test.js tests/phase2MaterialDownload.test.js tests/phase2FrontendDownload.test.js",
    "test:phase3": "node --test tests/phase3AttemptReporting.test.js tests/phase3Admin.integration.test.js",
    "test:phase4": "node --test tests/phase4Learning.integration.test.js",
    "seed": "node src/scripts/seedData.js",
    "seed:demo": "node src/scripts/seedDemoData.js",
    "seed:lesson-preview-demo": "node src/scripts/seedLessonMaterialPreviewDemo.js",
    "test:phase2-import": "node --test tests/phase2ToeicPart5Import.test.js",
    "test:phase5": "node --test tests/phase5ToeicPart1.test.js tests/phase5Cors.test.js",
    "test:toeic-crawler-import": "node --test tests/toeicCrawlerImport.test.js",
    "toeic:question-ocean:inspect": "node src/scripts/importToeicQuestionOcean.js",
    "toeic:question-ocean:import": "node src/scripts/importToeicQuestionOcean.js",
    "toeic:blob:upload": "node src/scripts/uploadToeicImagesToBlob.js",
    "toeic:explanations:translate": "node src/scripts/translateToeicExplanationsToVietnamese.js",
    "test:vocabulary-parser-v2": "node --test tests/docxVocabularyParserV2.test.js",
    "accept:vocabulary-parser-v2": "node tests/runDocxVocabularyParserV2Acceptance.js",
    "test:vocabulary-catalog-v1": "node --test tests/vocabularyCatalogV1.integration.test.js",
    "test:vocabulary-integration-v1-1": "node --test tests/vocabularyParserCatalogIntegration.test.js",
    "test:vocabulary-import-v3a": "node --test tests/vocabularyImportPrototype.integration.test.js",
    "test:vocabulary-catalog-v4a": "node --test tests/vocabularyCatalogV4a.integration.test.js",
    "test:vocabulary-student-catalog-v4b": "node --test tests/vocabularyStudentCatalogV4b.integration.test.js",
    "test:vocabulary-publication-v5a": "node --test tests/vocabularyPublicationV5a.integration.test.js",
    "test:vocabulary-application-integration": "node --test tests/vocabularyCatalogApplication.integration.test.js",
    "test:vocabulary-index-migration": "node --test tests/vocabularyCatalogIndexMigration.test.js",
    "vocabulary:indexes:check": "node src/scripts/ensureVocabularyCatalogIndexes.js",
    "vocabulary:indexes:apply": "node src/scripts/ensureVocabularyCatalogIndexes.js --apply",
    "vocabulary:inventory:readonly": "node src/scripts/inventoryVocabularyCatalogReadOnly.js",
    "migrate:standalone-learning-data": "node src/scripts/migrateStandaloneLearningData.js"
  },
  "keywords": [
    "english",
    "course",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "@xmldom/xmldom": "^0.8.15",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "sanitize-html": "2.18.1",
    "saxes": "^6.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "mongodb-memory-server": "^11.3.0"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "htmlparser2": "9.1.0"
  }
}
