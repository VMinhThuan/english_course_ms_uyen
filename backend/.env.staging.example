# Use APP_ENV to distinguish staging while keeping NODE_ENV compatible with
# Node/Express production behavior and serverless deployment.
APP_ENV=staging
NODE_ENV=production
PORT=3000

# Dedicated MongoDB Atlas staging project/cluster and database.
MONGODB_URI=mongodb+srv://<staging-user>:<staging-password>@<staging-cluster>.mongodb.net/english_course_staging?retryWrites=true&w=majority

JWT_SECRET=<staging-jwt-secret>
JWT_REFRESH_SECRET=<staging-refresh-secret>
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
# Enable only after staging validation and the learning-session index check.
AUTH_SESSION_ENFORCEMENT_STUDENTS=false
AUTH_REFRESH_ROTATION=false
AUTH_LEGACY_JWT_MIGRATION=true
FRONTEND_URL=https://<staging-frontend-origin>
FRONTEND_ORIGINS=https://<staging-frontend-origin>

# MongoDB is the shared authority for rate limiting and authentication.
RATE_LIMIT_NAMESPACE=staging

# Set only after confirming the number of trusted reverse-proxy hops.
# Leave at 0 if the deployment does not expose a verified proxy chain.
TRUST_PROXY_HOPS=0

# Migration/fixture commands only; do not put these in the running app env.
# ALLOW_LEARNING_STREAK_INDEXES=true
# ALLOW_STAGING_LEARNING_STREAK_FIXTURE=true
