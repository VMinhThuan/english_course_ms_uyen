# ----------------------------------------------------------------------
# TOEIC MS UYEN - APACHE CONFIGURATION (.htaccess)
# Designed for Long Van HN (cPanel Apache) SPA hosting
# ----------------------------------------------------------------------

# 1. MIME TYPES
<IfModule mod_mime.c>
  AddType application/javascript           .js .mjs
  AddType application/json                 .json
  AddType application/wasm                 .wasm
  AddType font/woff2                       .woff2
  AddType font/woff                        .woff
  AddType audio/mpeg                       .mp3
  AddType audio/mp4                        .m4a
  AddType audio/wav                        .wav
  AddType application/octet-stream         .traineddata
</IfModule>

# 2. GZIP / DEFLATE COMPRESSION
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/wasm
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 3. HTTP HEADERS & CACHING
<IfModule mod_headers.c>
  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Caching: index.html MUST NEVER be cached long-term to ensure immediate rollouts
  <Files "index.html">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Files>

  # Caching: Hashed immutable assets in /assets/ can be cached for 1 year
  <FilesMatch "\.(?:[a-zA-Z0-9_-]{8,}\.(?:js|mjs|css|png|jpe?g|gif|svg|webp|avif|woff2?)|[a-zA-Z0-9_-]+-[A-Za-z0-9_-]{8}\.(?:js|mjs|css|png|jpe?g|gif|svg|webp|avif|woff2?))$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# 4. REWRITE RULES FOR SPA ROUTING & CANONICAL DOMAIN
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 4.1 HTTPS Enforcement
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

  # 4.2 Canonical www redirect disabled to prevent redirect loop with browser-cached Vercel 308
  # Both apex and www are served directly by Apache on Long Van
  # RewriteCond %{HTTP_HOST} ^www\.toeicmsuyen\.vn$ [NC]
  # RewriteRule ^(.*)$ https://toeicmsuyen.vn/$1 [R=301,L,NE]

  # 4.3 If requested resource is an existing file or directory, serve directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4.4 Missing API requests: DO NOT rewrite to index.html; return 404 immediately
  # Frontend production talks directly to https://api.toeicmsuyen.vn/api/v1
  RewriteRule ^api(?:/|$) - [R=404,L,NC]

  # 4.5 Missing static assets: DO NOT rewrite to index.html; return 404 immediately
  # Prevents HTML fallback on missing JS chunks, audio, images, or fonts
  RewriteCond %{REQUEST_URI} ^/(?:assets|audio|uploads)/ [NC,OR]
  RewriteCond %{REQUEST_URI} \.(?:js|mjs|cjs|css|png|jpe?g|gif|ico|svg|webp|avif|woff2?|ttf|eot|otf|mp3|m4a|wav|ogg|pdf|json|wasm|map|txt|traineddata)$ [NC]
  RewriteRule ^ - [R=404,L]

  # 4.6 SPA fallback: Send all real navigation routes to index.html
  RewriteRule ^index\.html$ - [L]
  RewriteRule . /index.html [L]
</IfModule>
